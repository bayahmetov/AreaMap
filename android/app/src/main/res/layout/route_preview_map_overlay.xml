<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:clipChildren="false" android:clipToPadding="false" android:id="@+id/route_preview_overlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:visibility="gone">
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_areamap_hike" android:tint="@color/areamap_green" android:importantForAccessibility="no" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AreaMap" android:textStyle="bold" android:textSize="18sp" android:textColor="@color/areamap_green" android:layout_marginEnd="10dp" />
    <TextView android:id="@+id/route_preview_search" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/bg_route_preview_card" android:text="@string/search" android:textColor="@color/areamap_text_secondary" android:drawableStart="@drawable/ic_search" android:drawablePadding="8dp" />
    <ImageButton android:id="@+id/route_preview_settings" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:background="@drawable/bg_route_preview_card" android:src="@drawable/ic_settings" android:tint="@color/areamap_text" android:contentDescription="@string/settings" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="top">
    <LinearLayout android:id="@+id/route_preview_weather_card" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_route_preview_card" android:padding="10dp">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/route_preview_weather_icon" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_preview_sun" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/route_preview_temperature" android:textSize="22sp" android:textColor="@color/areamap_text" android:layout_marginStart="7dp" android:textStyle="bold" />
      </LinearLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/route_preview_condition" android:textSize="11sp" android:textColor="@color/areamap_text_secondary" android:maxLines="2" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/route_preview_wind" android:textSize="11sp" android:textColor="@color/areamap_text_secondary" android:layout_marginTop="5dp" />
    </LinearLayout>
    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="48dp" android:layout_height="wrap_content" android:orientation="vertical">
      <ImageButton android:id="@+id/route_preview_layers" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_route_preview_card" android:src="@drawable/ic_layers" android:tint="@color/areamap_text" android:contentDescription="@string/layers_title" />
      <ImageButton android:id="@+id/route_preview_location" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_route_preview_card" android:src="@drawable/ic_location_crosshair" android:tint="@color/areamap_text" android:contentDescription="@string/core_my_position" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>