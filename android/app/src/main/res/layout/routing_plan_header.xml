<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/routing_types_header"
  android:layout_width="match_parent"
  android:layout_height="58dp"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="18dp"
  android:paddingEnd="12dp">

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/areamap_title"
    android:textColor="@color/areamap_text"
    android:textSize="20sp"
    android:textStyle="bold" />

  <TextView
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_weight="1"
    android:text="@string/areamap_route_kicker"
    android:textColor="@color/areamap_green"
    android:textSize="12sp"
    android:textStyle="bold" />

  <!-- Kept in the hierarchy because RoutingPlanFragment owns these ids.
       AreaMap route entry points use Pedestrian; the legacy mode picker is intentionally hidden. -->
  <RadioGroup
    android:id="@+id/route_type"
    android:layout_width="1dp"
    android:layout_height="1dp"
    android:visibility="gone">
    <app.organicmaps.widget.RoutingToolbarButton android:id="@+id/vehicle" style="@style/MwmWidget.RoutingToolbarCell" android:button="@drawable/ic_car" />
    <app.organicmaps.widget.RoutingToolbarButton android:id="@+id/pedestrian" style="@style/MwmWidget.RoutingToolbarCell" android:button="@drawable/ic_pedestrian" android:checked="true" />
    <app.organicmaps.widget.RoutingToolbarButton android:id="@+id/transit" style="@style/MwmWidget.RoutingToolbarCell" android:button="@drawable/ic_transit" />
    <app.organicmaps.widget.RoutingToolbarButton android:id="@+id/bicycle" style="@style/MwmWidget.RoutingToolbarCell" android:button="@drawable/ic_bike" />
    <app.organicmaps.widget.RoutingToolbarButton android:id="@+id/ruler" style="@style/MwmWidget.RoutingToolbarCell" android:button="@drawable/ic_ruler_route" />
  </RadioGroup>

  <ImageButton
    android:id="@+id/back"
    android:layout_width="42dp"
    android:layout_height="42dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:contentDescription="@string/close"
    android:padding="9dp"
    app:srcCompat="@drawable/ic_close_rounded"
    app:tint="@color/areamap_text_secondary" />

</LinearLayout>
