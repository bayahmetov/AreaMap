<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/areamap_bg"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="20dp"
      android:paddingEnd="20dp"
      android:paddingTop="18dp"
      android:paddingBottom="32dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/areamap_guides_page_title"
        android:textColor="@color/areamap_text"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/areamap_guides_page_subtitle"
        android:textColor="@color/areamap_text_secondary"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/guide_language"
        style="@style/AreaMap.SecondaryButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:minHeight="44dp"
        android:text="@string/areamap_language_change"
        android:textSize="13sp" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/guide_search"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_areamap_search_input"
        android:hint="@string/areamap_search_articles"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:singleLine="true"
        android:textColor="@color/areamap_text"
        android:textColorHint="@color/areamap_text_muted"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/areamap_medical_disclaimer"
        android:textColor="@color/areamap_text_muted"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp" />

    <LinearLayout
        android:id="@+id/guide_articles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical" />
  </LinearLayout>
</ScrollView>
