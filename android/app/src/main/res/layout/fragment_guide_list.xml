<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/areamap_bg"
    android:fillViewport="true">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="18dp"
      android:paddingEnd="18dp"
      android:paddingTop="16dp"
      android:paddingBottom="36dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:background="@drawable/bg_areamap_outline"
        android:orientation="vertical"
        android:padding="18dp">
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/areamap_guides_hero_kicker"
          android:textColor="@color/areamap_text_secondary"
          android:textSize="12sp"
          android:textStyle="bold"/>
      <TextView
          android:layout_width="260dp"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="@string/areamap_guides_hero_title"
          android:textColor="@color/areamap_text"
          android:textSize="30sp"
          android:textStyle="bold"/>
      <TextView
          android:layout_width="270dp"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="@string/areamap_guides_hero_subtitle"
          android:textColor="@color/areamap_text_secondary"
          android:textSize="14sp"
          android:lineSpacingExtra="3dp"/>
      <com.google.android.material.button.MaterialButton
          android:id="@+id/guide_language"
          style="@style/AreaMap.SecondaryButton"
          android:layout_width="wrap_content"
          android:layout_height="42dp"
          android:layout_marginTop="14dp"
          android:minHeight="42dp"
          android:text="@string/areamap_language_change"/>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/guide_search"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_areamap_search_input"
        android:hint="@string/areamap_search_articles"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:singleLine="true"
        android:textColor="@color/areamap_text"
        android:textColorHint="@color/areamap_text_muted"
        android:textSize="15sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/areamap_guides_categories"
        android:textColor="@color/areamap_text"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:baselineAligned="false">
      <TextView style="@style/AreaMap.GuideCategoryCard" android:text="🗺&#10;&#10;Подготовка маршрута"/>
      <TextView style="@style/AreaMap.GuideCategoryCard" android:text="☁️&#10;&#10;Погода и снаряжение"/>
      <TextView style="@style/AreaMap.GuideCategoryCard" android:text="🔥&#10;&#10;Выживание в горах"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
      <TextView style="@style/AreaMap.GuideCategoryCard" android:text="🐾&#10;&#10;Дикие животные"/>
      <TextView style="@style/AreaMap.GuideCategoryCard" android:text="🌿&#10;&#10;Растения"/>
      <TextView style="@style/AreaMap.GuideCategoryCard" android:text="💧&#10;&#10;Источники воды"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/areamap_guides_popular"
        android:textColor="@color/areamap_text"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/areamap_medical_disclaimer"
        android:textColor="@color/areamap_text_muted"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp"/>

    <LinearLayout
        android:id="@+id/guide_articles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"/>
  </LinearLayout>
</ScrollView>