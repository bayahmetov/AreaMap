<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/home_sheet"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/home_sheet"
  app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
  app:behavior_hideable="false"
  app:paddingBottomSystemWindowInsets="false"
  app:behavior_peekHeight="@dimen/home_peek">
  <FrameLayout
    android:id="@+id/home_handle"
    android:layout_width="match_parent"
    android:layout_height="28dp"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="@string/home_toggle">
    <View
      android:layout_width="36dp"
      android:layout_height="4dp"
      android:layout_gravity="center"
      android:background="@drawable/home_surface"/>
  </FrameLayout>
  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="false">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingBottom="@dimen/home_padding">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/home_padding"
        android:paddingEnd="@dimen/home_padding">
        <ImageView
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:src="@drawable/home_logo"
          android:importantForAccessibility="no"/>
        <TextView
          style="@style/AreaMap.HomeText"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:layout_marginStart="@dimen/home_gap"
          android:text="@string/home_popular"
          android:textStyle="bold"
          android:textSize="@dimen/home_title_size"/>
        <TextView
          android:id="@+id/home_all"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:minHeight="48dp"
          android:maxWidth="100dp"
          android:gravity="center"
          android:paddingStart="@dimen/home_gap"
          android:text="@string/home_all_places"
          android:textColor="@color/areamap_green"
          android:textStyle="bold"
          android:textSize="14sp"
          android:clickable="true"
          android:focusable="true"/>
      </LinearLayout>
      <TextView
        style="@style/AreaMap.HomeText"
        android:paddingStart="@dimen/home_padding"
        android:paddingEnd="@dimen/home_padding"
        android:layout_marginBottom="12dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/home_subtitle"
        android:textColor="@color/areamap_text_secondary"/>
      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/home_recommendations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/home_padding"
        android:paddingEnd="@dimen/home_padding"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"/>
      <TextView
        android:id="@+id/home_photo_credits"
        style="@style/AreaMap.HomeText"
        android:padding="@dimen/home_padding"
        android:minHeight="48dp"
        android:text="@string/home_photo_credits"
        android:textColor="@color/areamap_green"
        android:clickable="true"
        android:focusable="true"/>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</LinearLayout>
