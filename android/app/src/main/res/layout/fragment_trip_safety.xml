<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/areamap_guide_title"
        android:textSize="30sp"
        android:textColor="?android:attr/textColorPrimary"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:textColor="?android:attr/textColorSecondary"
        android:text="@string/areamap_guide_intro" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/guide_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/areamap_search_articles"
        android:background="@drawable/bg_areamap_surface"
        android:padding="18dp"
        android:minHeight="56dp"
        android:textSize="16sp"
        android:inputType="text"
        android:maxLines="1"
        android:singleLine="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="20sp"
        android:text="@string/areamap_articles_title"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp"
        android:textColor="?android:attr/textColorSecondary"
        android:text="@string/areamap_medical_disclaimer" />

    <LinearLayout
        android:id="@+id/guide_articles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        style="@style/AreaMap.ActionButton"
        android:id="@+id/guide_import"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/areamap_import" />

    <TextView
        android:id="@+id/trip_coordinates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textIsSelectable="true"
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary" />

    <com.google.android.material.button.MaterialButton
        style="@style/AreaMap.ActionButton"
        android:id="@+id/trip_sos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:backgroundTint="#B83B46"
        android:text="@string/areamap_sos" />

  </LinearLayout>
</ScrollView>
