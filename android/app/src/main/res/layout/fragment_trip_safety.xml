<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/areamap_bg"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="20dp"
      android:paddingEnd="20dp"
      android:paddingTop="18dp"
      android:paddingBottom="32dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/areamap_hike_page_title"
        android:textColor="@color/areamap_text"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/areamap_hike_page_subtitle"
        android:textColor="@color/areamap_text_secondary"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />

    <LinearLayout
        android:id="@+id/active_trip_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_areamap_feed_card"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/areamap_active_trip_title"
          android:textColor="@color/areamap_text"
          android:textSize="20sp"
          android:textStyle="bold" />

      <TextView
          android:id="@+id/active_trip_summary"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:textColor="@color/areamap_text_secondary"
          android:textSize="14sp"
          android:lineSpacingExtra="3dp" />

      <com.google.android.material.button.MaterialButton
          android:id="@+id/active_trip_resend"
          style="@style/AreaMap.SecondaryButton"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="14dp"
          android:text="@string/areamap_resend_trip_report" />

      <com.google.android.material.button.MaterialButton
          android:id="@+id/active_trip_finish"
          style="@style/AreaMap.ActionButton"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="@string/areamap_manual_return" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_areamap_result"
        android:orientation="vertical"
        android:padding="18dp">

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/areamap_quick_gpx"
          android:textColor="@color/areamap_text"
          android:textSize="19sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:text="@string/areamap_hike_gpx_summary"
          android:textColor="@color/areamap_text_secondary"
          android:textSize="13sp" />

      <com.google.android.material.button.MaterialButton
          android:id="@+id/guide_import"
          style="@style/AreaMap.SecondaryButton"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:text="@string/areamap_import" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/schedule_demo_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_areamap_feed_card_alt"
        android:orientation="vertical"
        android:padding="18dp">

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/areamap_schedule_demo_title"
          android:textColor="@color/areamap_text"
          android:textSize="19sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:text="@string/areamap_schedule_demo_description"
          android:textColor="@color/areamap_text_secondary"
          android:textSize="13sp"
          android:lineSpacingExtra="3dp" />

      <com.google.android.material.button.MaterialButton
          android:id="@+id/schedule_demo_notification"
          style="@style/AreaMap.SecondaryButton"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:text="@string/areamap_schedule_demo_button" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/language_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_areamap_result"
        android:orientation="vertical"
        android:padding="18dp">

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/areamap_language_title"
          android:textColor="@color/areamap_text"
          android:textSize="19sp"
          android:textStyle="bold" />

      <TextView
          android:id="@+id/language_current"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:textColor="@color/areamap_text_secondary"
          android:textSize="13sp" />

      <com.google.android.material.button.MaterialButton
          android:id="@+id/language_change"
          style="@style/AreaMap.SecondaryButton"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:text="@string/areamap_language_change" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_areamap_feed_card_sos"
        android:orientation="vertical"
        android:padding="18dp">

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/areamap_sos"
          android:textColor="@color/areamap_text"
          android:textSize="20sp"
          android:textStyle="bold" />

      <TextView
          android:id="@+id/trip_coordinates"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:textColor="@color/areamap_text_secondary"
          android:textIsSelectable="true"
          android:textSize="13sp"
          android:lineSpacingExtra="3dp" />

      <com.google.android.material.button.MaterialButton
          android:id="@+id/trip_sos"
          style="@style/AreaMap.ActionButton"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:text="@string/areamap_sos"
          app:backgroundTint="@color/areamap_red" />
    </LinearLayout>

  </LinearLayout>
</ScrollView>
