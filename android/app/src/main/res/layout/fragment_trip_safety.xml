<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/areamap_bg">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/areamap_guide_title"
        android:textSize="30sp"
        android:textColor="@color/areamap_text"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/areamap_text_secondary"
        android:text="@string/areamap_guide_intro" />

    <LinearLayout
        android:id="@+id/active_trip_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_areamap_feed_card"
        android:visibility="gone">

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/areamap_active_trip_title"
          android:textColor="@color/areamap_text"
          android:textSize="18sp"
          android:textStyle="bold" />

      <TextView
          android:id="@+id/active_trip_summary"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:textColor="@color/areamap_text_secondary"
          android:textSize="13sp" />

      <com.google.android.material.button.MaterialButton
          android:id="@+id/active_trip_resend"
          style="@style/AreaMap.SecondaryButton"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:text="@string/areamap_resend_trip_report" />

      <com.google.android.material.button.MaterialButton
          android:id="@+id/active_trip_finish"
          style="@style/AreaMap.ActionButton"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="@string/areamap_manual_return" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/schedule_demo_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_areamap_feed_card_alt">

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/areamap_schedule_demo_title"
          android:textColor="@color/areamap_text"
          android:textSize="18sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:text="@string/areamap_schedule_demo_description"
          android:textColor="@color/areamap_text_secondary"
          android:textSize="13sp" />

      <com.google.android.material.button.MaterialButton
          android:id="@+id/schedule_demo_notification"
          style="@style/AreaMap.SecondaryButton"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:text="@string/areamap_schedule_demo_button" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/guide_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/areamap_search_articles"
        android:background="@drawable/bg_areamap_search_input"
        android:padding="18dp"
        android:textColor="@color/areamap_text"
        android:textColorHint="@color/areamap_text_muted"
        android:minHeight="56dp"
        android:textSize="16sp"
        android:inputType="text"
        android:maxLines="1"
        android:singleLine="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="20sp"
        android:text="@string/areamap_articles_title"
        android:textColor="@color/areamap_text"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/areamap_text_secondary"
        android:text="@string/areamap_medical_disclaimer" />

    <LinearLayout
        android:id="@+id/guide_articles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        style="@style/AreaMap.ActionButton"
        android:id="@+id/guide_import"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/areamap_import" />

    <TextView
        android:id="@+id/trip_coordinates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textIsSelectable="true"
        android:textSize="13sp"
        android:textColor="@color/areamap_text_secondary" />

    <com.google.android.material.button.MaterialButton
        style="@style/AreaMap.ActionButton"
        android:id="@+id/trip_sos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:backgroundTint="#B83B46"
        android:text="@string/areamap_sos" />

  </LinearLayout>
</ScrollView>
