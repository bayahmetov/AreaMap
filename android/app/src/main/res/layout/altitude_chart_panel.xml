<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/altitude_chart_panel"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginTop="@dimen/margin_quarter_plus"
  android:layout_weight="1"
  android:orientation="vertical"
  android:paddingBottom="@dimen/margin_half_plus"
  tools:showIn="@layout/routing_bottom_sheet">

  <LinearLayout
    android:paddingStart="@dimen/routing_plan_horizontal_padding"
    android:paddingEnd="@dimen/routing_plan_horizontal_padding"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
      android:orientation="vertical"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content">

      <TextView
        android:id="@+id/time_vehicle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        tools:text="5 h 55 min • 1555km"
        tools:visibility="visible"
        android:layout_marginTop="@dimen/margin_half"
        android:visibility="gone" />

      <LinearLayout
        android:id="@+id/time_elevation_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_half"
        android:layout_marginBottom="@dimen/margin_half"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/time"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:maxLines="2"
          tools:text="5 h 55 min • 1555km"
          tools:visibility="visible" />

        <TextView
          android:id="@+id/altitude_difference"
          android:layout_width="wrap_content"
          android:layout_height="@dimen/altitude_chart_time_distance_height"
          android:fontFamily="@string/robotoMedium"
          android:gravity="center"
          android:textAppearance="@style/MwmTextAppearance.Body3"
          android:textColor="?colorAccent"
          android:visibility="gone"
          tools:text="↗ 43 m ↘ 88 m"
          tools:visibility="visible"
          android:layout_marginStart="@dimen/margin_half" />
      </LinearLayout>

      <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/transit_time"
        android:layout_marginTop="@dimen/margin_half"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
          android:id="@+id/total_time"
          style="@style/MwmWidget.TextView.PlanDetail.Number.Time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          tools:text="40 min" />

        <TextView
          android:id="@+id/dot"
          style="@style/MwmWidget.TextView.PlanDetail.Number.Secondary"
          android:text="•"
          tools:ignore="HardcodedText"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/margin_quarter_plus" />

        <ImageView
          android:id="@+id/pedestrian_icon"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:srcCompat="@drawable/ic_20px_route_planning_walk"
          app:tint="?iconTint"
          android:layout_marginStart="@dimen/margin_quarter_plus" />

        <TextView
          android:id="@+id/total_distance"
          style="@style/MwmWidget.TextView.PlanDetail.Number.Secondary"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          tools:text="1 km"
          android:layout_marginStart="@dimen/margin_quarter_plus" />
      </LinearLayout>

      <TextView
        android:id="@+id/time_ruler"
        style="@style/MwmWidget.TextView.PlanDetail.Number.Time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="40 min"
        android:layout_marginTop="@dimen/margin_half"
        android:visibility="gone"
        tools:visibility="visible" />

    </LinearLayout>

    <FrameLayout
      android:id="@+id/driving_options_btn_container"
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

      <ImageView
        android:id="@+id/driving_options_btn_img"
        android:layout_width="@dimen/margin_double"
        android:layout_height="@dimen/margin_double"
        android:layout_gravity="end"
        app:srcCompat="@drawable/ic_menu_settings"
        app:tint="?iconTint" />

      <!-- Layer 2: The Badge (on top of the icon) -->
      <TextView
        android:id="@+id/driving_options_badge"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_gravity="top|end"
        android:background="@drawable/badge_background"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="8sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="2"
        tools:visibility="visible" />
    </FrameLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/areamap_route_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/routing_plan_horizontal_padding"
    android:layout_marginEnd="@dimen/routing_plan_horizontal_padding"
    android:layout_marginBottom="@dimen/margin_half"
    android:background="@drawable/bg_areamap_outline"
    android:orientation="vertical"
    android:padding="16dp"
    android:visibility="gone"
    tools:visibility="visible">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/areamap_route_kicker"
      android:textColor="@color/areamap_green"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/areamap_route_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="@string/areamap_route_untitled"
      android:textColor="@color/areamap_text"
      android:textSize="23sp"
      android:textStyle="bold" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:baselineAligned="false"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/areamap_route_metric_distance"
        style="@style/AreaMap.RouteMetric" />

      <TextView
        android:id="@+id/areamap_route_metric_ascent"
        style="@style/AreaMap.RouteMetric" />

      <TextView
        android:id="@+id/areamap_route_metric_time"
        style="@style/AreaMap.RouteMetric" />
    </LinearLayout>

    <TextView
      android:id="@+id/areamap_route_warning"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:background="@drawable/bg_areamap_feed_card_warn"
      android:padding="12dp"
      android:textColor="@color/areamap_orange"
      android:textSize="13sp"
      android:textStyle="bold"
      android:visibility="gone"
      tools:text="⚠ Finish after dark"
      tools:visibility="visible" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:background="@drawable/bg_areamap_stat"
      android:orientation="vertical"
      android:padding="12dp">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/areamap_route_weather_preview_title"
        android:textColor="@color/areamap_text"
        android:textSize="14sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/areamap_route_weather"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/areamap_weather_no_cache"
        android:textColor="@color/areamap_text_secondary"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
      android:id="@+id/areamap_route_details"
      style="@style/AreaMap.SecondaryButton"
      android:layout_width="match_parent"
      android:layout_height="46dp"
      android:layout_marginTop="10dp"
      android:minHeight="46dp"
      android:text="@string/areamap_route_details" />

    <TextView
      android:id="@+id/areamap_route_advice"
      android:visibility="gone"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textColor="@color/areamap_text_secondary"
      android:textSize="13sp"
      tools:text="Route-specific advice" />

    <TextView
      android:id="@+id/areamap_route_checkpoints"
      android:visibility="gone"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:textColor="@color/areamap_text_secondary"
      android:textSize="13sp"
      android:lineSpacingExtra="3dp"
      tools:text="Checkpoint 1 · 1 h 15 min · 4.2 km" />

    <TextView
      android:id="@+id/areamap_route_peaks"
      android:visibility="gone"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:textColor="@color/areamap_text_secondary"
      android:textSize="13sp"
      tools:text="Peak 1 · 2 h 10 min · 2400 m" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:orientation="horizontal">

      <com.google.android.material.button.MaterialButton
        android:id="@+id/areamap_route_guide"
        style="@style/AreaMap.ActionButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:text="@string/areamap_guide_button" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/areamap_route_sos"
        style="@style/AreaMap.ActionButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:text="@string/areamap_sos" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
      android:id="@+id/areamap_route_import"
      style="@style/AreaMap.SecondaryButton"
      android:layout_width="match_parent"
      android:layout_height="44dp"
      android:layout_marginTop="8dp"
      android:minHeight="44dp"
      android:text="@string/areamap_import" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/altitude_chart_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <include
      layout="@layout/route_elevation_profile"
      android:id="@+id/altitude_chart"
      android:layout_width="match_parent"
      android:layout_height="@dimen/route_chart_height"
      android:visibility="gone" />

  </LinearLayout>

  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/transit_recycler_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/routing_plan_horizontal_padding"
    android:layout_marginEnd="@dimen/routing_plan_horizontal_padding"
    android:layout_marginTop="@dimen/margin_half_plus"
    android:visibility="gone"
    tools:visibility="visible" />

</LinearLayout>
