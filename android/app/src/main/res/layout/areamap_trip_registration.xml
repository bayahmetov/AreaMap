<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/areamap_bg"
    android:fillViewport="true">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="20dp"
      android:paddingEnd="20dp"
      android:paddingTop="10dp"
      android:paddingBottom="18dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/areamap_registration_intro" android:textColor="@color/areamap_text_secondary" android:textSize="13sp" android:lineSpacingExtra="3dp"/>
    <TextView android:id="@+id/trip_registration_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_areamap_outline" android:padding="16dp" android:textColor="@color/areamap_text" android:textSize="13sp" android:lineSpacingExtra="3dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/areamap_registration_participant" android:textColor="@color/areamap_text" android:textSize="18sp" android:textStyle="bold"/>
    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/trip_registration_name" style="@style/AreaMap.FormField" android:hint="@string/areamap_trip_name" android:inputType="textPersonName"/>
    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/trip_registration_phone" style="@style/AreaMap.FormField" android:hint="@string/areamap_trip_phone" android:inputType="phone"/>
    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/trip_registration_group_size" style="@style/AreaMap.FormField" android:hint="@string/areamap_trip_group_size" android:inputType="number"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/areamap_registration_emergency" android:textColor="@color/areamap_text" android:textSize="18sp" android:textStyle="bold"/>
    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/trip_registration_emergency_name" style="@style/AreaMap.FormField" android:hint="@string/areamap_trip_emergency_name" android:inputType="textPersonName"/>
    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/trip_registration_emergency_phone" style="@style/AreaMap.FormField" android:hint="@string/areamap_trip_emergency_phone" android:inputType="phone"/>

    <CheckBox
        android:id="@+id/trip_registration_consent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:buttonTint="@color/areamap_green"
        android:text="@string/areamap_trip_consent"
        android:textColor="@color/areamap_text"
        android:textSize="13sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_areamap_outline"
        android:padding="14dp"
        android:text="@string/areamap_registration_demo_note"
        android:textColor="@color/areamap_text_secondary"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp"/>
  </LinearLayout>
</ScrollView>