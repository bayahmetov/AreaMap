<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_margin="12dp"
  android:background="@drawable/bg_areamap_sheet"
  android:elevation="8dp"
  android:orientation="vertical"
  android:padding="14dp"
  android:visibility="gone"
  tools:visibility="visible">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/areamap_follow_track"
      android:textStyle="bold" />

    <Button
      android:id="@+id/areamap_track_stop"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/areamap_track_stop" />
  </LinearLayout>

  <TextView
    android:id="@+id/areamap_track_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:accessibilityLiveRegion="polite"
    android:text="@string/areamap_track_waiting" />
</LinearLayout>
