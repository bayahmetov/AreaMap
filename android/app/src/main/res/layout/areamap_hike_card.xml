<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="@dimen/home_card_width"
  android:layout_height="@dimen/home_card_height"
  android:layout_marginEnd="@dimen/home_gap"
  android:background="@drawable/destination_card"
  android:clickable="true"
  android:focusable="true">
  <ImageView
    android:id="@+id/hike_photo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="centerCrop"
    android:importantForAccessibility="no"/>
  <View
    android:id="@+id/hike_gradient"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/home_photo_gradient"
    android:layout_gravity="bottom"/>
  <ImageButton
    android:id="@+id/hike_favorite"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:layout_gravity="top|end"
    android:padding="12dp"
    android:background="@drawable/home_badge"
    android:src="@drawable/home_heart"/>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:padding="12dp"
    android:orientation="vertical">
    <TextView
      android:id="@+id/hike_title"
      style="@style/AreaMap.HomeText"
      android:textSize="20sp"
      android:textStyle="bold"
      android:textColor="@color/home_photo_text"
      android:maxLines="2"
      android:ellipsize="end"/>
    <TextView
      android:id="@+id/hike_altitude"
      style="@style/AreaMap.HomeText"
      android:textColor="@color/home_photo_text"
      android:textSize="14sp"/>
    <TextView
      android:id="@+id/hike_details"
      style="@style/AreaMap.HomeText"
      android:layout_marginTop="@dimen/home_gap"
      android:textColor="@color/home_photo_text"
      android:textSize="14sp"
      android:maxLines="2"
      android:ellipsize="end"/>
  </LinearLayout>
</FrameLayout>
